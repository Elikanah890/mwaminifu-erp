# ---------------------------------------------------------------------------
# Backend environment template. Copy to `.env` for local development. In
# production set every value through your hosting platform (Render, etc.).
# NEVER commit a real `.env` file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET="change_this_to_a_secure_random_string_at_least_32_chars"
JWT_ACCESS_EXPIRY="30d"
JWT_REFRESH_EXPIRY="60d"

# --- Messaging -----------------------------------------------------------------
# MOCK_SMS/MOCK_FCM MUST be false in production (startup fails otherwise).
MOCK_SMS=true
MOCK_FCM=true

# Real SMS gateway (used when MOCK_SMS=false). Providers: beem | http
SMS_PROVIDER=beem
SMS_API_URL="https://apisms.beem.africa/v1/send"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="MWAMINIFU"
# Estimated cost per 160-char SMS segment (used for logging/analytics).
SMS_COST_PER_SEGMENT=0.02

# Firebase Cloud Messaging (used when MOCK_FCM=false).
FCM_SERVER_KEY=""
FCM_API_URL="https://fcm.googleapis.com/fcm/send"

# --- Server --------------------------------------------------------------------
LOG_LEVEL=debug
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"
# Number of reverse-proxy hops to trust (set to 1 on Render/Vercel/nginx).
# Keep 0 for local development.
TRUST_PROXY=0

# --- Seed / test accounts (used only by `npx prisma db seed`) ------------------
# In production the seed script requires these (no insecure defaults).
SYSTEM_OWNER_USERNAME=admin
SYSTEM_OWNER_PASSWORD=
AGENT_TEST_USERNAME=agent1
AGENT_TEST_PASSWORD=
OWNER_TEST_PHONE=0754000000
OWNER_TEST_PIN=123456

# --- Client-testing escape hatch ----------------------------------------------
# Set true ONLY on a temporary test VPS to allow MOCK_SMS/MOCK_FCM while
# NODE_ENV=production. Leave unset/false for real production.
ALLOW_MOCK_MESSAGING=false
