# ---------------------------------------------------------------------------
# Mwaminifu backend — PRODUCTION / free-VPS client testing template.
# Copy to `.env` on the server and fill every value. NEVER commit the real .env.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Use a dedicated DB user and a strong password. Bind to localhost if Postgres
# runs on the same VPS.
DATABASE_URL="postgresql://mwaminifu_user:CHANGE_ME@localhost:5432/mwaminifu_db?schema=public"

# 32+ random chars. Generate:  openssl rand -hex 32
JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"
JWT_ACCESS_EXPIRY="1d"
JWT_REFRESH_EXPIRY="30d"

# --- Reverse proxy / CORS -----------------------------------------------------
# Client-test URL, e.g. https://mwaminifu.example.com
CORS_ORIGIN="https://CHANGE_ME.example.com"
# nginx terminates TLS in front of the API -> trust 1 hop.
TRUST_PROXY=1
LOG_LEVEL=info

# --- Messaging ----------------------------------------------------------------
# For a free test VPS without an SMS gateway, use mocked OTP (OTP always 123456)
# AND set ALLOW_MOCK_MESSAGING=true below so the server will start.
MOCK_SMS=true
MOCK_FCM=true
ALLOW_MOCK_MESSAGING=true
# Temporary client-testing: raises auth/OTP/general rate limits and removes the
# System Owner 2-session cap so testers are not locked out. Implied by
# MOCK_SMS + ALLOW_MOCK_MESSAGING. Leave unset for real production.
RATE_LIMIT_RELAXED=true
# For real SMS set MOCK_SMS=false and configure:
SMS_PROVIDER=beem
SMS_API_URL="https://apisms.beem.africa/v1/send"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="MWAMINIFU"

# --- Seed / test accounts (only used by `npx prisma db seed`) ------------------
# Email + password are the sign-in credentials after the email/password migration.
SYSTEM_OWNER_USERNAME=admin
SYSTEM_OWNER_EMAIL="admin@YOUR_DOMAIN"
SYSTEM_OWNER_PASSWORD="CHANGE_ME_strong_owner_password"
AGENT_TEST_USERNAME=agent1
AGENT_TEST_EMAIL="agent1@YOUR_DOMAIN"
AGENT_TEST_PASSWORD="CHANGE_ME_strong_agent_password"
OWNER_TEST_PHONE=0754000000
OWNER_TEST_EMAIL="owner@YOUR_DOMAIN"
OWNER_TEST_PASSWORD="CHANGE_ME_strong_owner_password"

# Set true to allow `prisma db seed` to wipe+create demo data on this server.
SEED_ALLOW_PRODUCTION=false

# --- Transactional email (Resend) ---------------------------------------------
# REQUIRED in production for welcome + password-reset emails. Without it, emails
# are only printed to the server console and users cannot reset passwords.
RESEND_API_KEY=""
EMAIL_FROM="Mwaminifu <no-reply@YOUR_DOMAIN>"
# Public HTTPS frontend URL used in password-reset links.
FRONTEND_URL="https://YOUR_DOMAIN"
