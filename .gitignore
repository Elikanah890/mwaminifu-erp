# ---------------------------------------------------------------------------
# Environment files — NEVER commit real secrets.
# Real values are injected by the hosting platform (Vercel / Render / etc.).
# `.env.example` files contain placeholders only and ARE tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Node / JS build artifacts
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.next/
out/
coverage/
.turbo/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.pyc

# Dart/Flutter tooling (any location)
.dart_tool/

# ---------------------------------------------------------------------------
# Flutter / Dart
# ---------------------------------------------------------------------------
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/**/android/local.properties
mobile/**/ios/Flutter/Generated.xcconfig
mobile/**/ios/Flutter/flutter_export_environment.sh

# ---------------------------------------------------------------------------
# Prisma local database files
# ---------------------------------------------------------------------------
*.db
*.db-journal

# ---------------------------------------------------------------------------
# OS / editor / tooling
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.playwright-mcp/
