# ---------------------------------------------------------------------------
# Mwaminifu Admin (Next.js) — PRODUCTION template. Copy to `.env.local`.
# ---------------------------------------------------------------------------
# IMPORTANT: auth cookies are marked `Secure` when NODE_ENV=production, so the
# app MUST be served over HTTPS. Plain HTTP will silently drop the session
# cookies and every login will appear to fail.
# Public site URL used in links/redirects.
NEXT_PUBLIC_APP_URL="https://CHANGE_ME.example.com"
NEXT_PUBLIC_SITE_URL="https://CHANGE_ME.example.com"

# Backend API base URL. Server-side only (BFF proxy + auth routes).
BACKEND_API_URL="https://CHANGE_ME.example.com/api/v1"
NEXT_PUBLIC_API_URL="https://CHANGE_ME.example.com/api/v1"
NEXT_PUBLIC_APP_NAME="Mwaminifu"

# MUST exactly match the backend JWT_SECRET (server-side only).
JWT_SECRET="CHANGE_ME_same_as_backend_JWT_SECRET"
