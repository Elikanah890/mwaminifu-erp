# ---------------------------------------------------------------------------
# Mwaminifu Admin (Next.js) — environment template
# Copy to .env.local for local development. In production set these as
# environment variables in your hosting platform (Vercel Project Settings).
# NEVER commit a real .env / .env.local file.
# ---------------------------------------------------------------------------

# Backend API base URL. Used server-side only by the BFF proxy/auth routes.
# It is never exposed to the browser.
BACKEND_API_URL="http://localhost:5000/api/v1"

# Public API URL (kept for reference/compatibility). The browser talks to the
# same-origin /api/proxy instead of calling the backend directly.
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Application display name.
NEXT_PUBLIC_APP_NAME="Mwaminifu Admin"

# Secret used to verify the signed access-token JWT on the server (middleware /
# BFF). MUST match the backend JWT_SECRET. Server-side only — never prefix with
# NEXT_PUBLIC_.
JWT_SECRET="replace_with_a_random_256_bit_secret_matching_backend"
